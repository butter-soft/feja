    "clean": "node scripts/clean.ts",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "pnpm clean && pnpm build"
  },
  "dependencies": {
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "expo": "^58.0.21",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "^19.2.0",
    "react-native": "*"
  },
  "packageManager": "pnpm@11.28.12"
