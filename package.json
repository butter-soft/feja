{
  "name": "feja",
  "version": "0.1.0",
  "description": "An Expo module for building proximity-aware experiences with BLE beacons on iOS and Android.",
  "keywords": [
    "ble",
    "bluetooth",
    "expo",
    "feja",
    "react-native"
  ],
  "homepage": "https://github.com/butter-soft/feja#readme",
  "bugs": {
    "url": "https://github.com/butter-soft/feja/issues"
  },
  "license": "MIT",
  "author": "Jung Wook Park <jwpark@buttersoft.io> (https://github.com/hatchling13)",
  "repository": "https://github.com/butter-soft/feja",
  "files": [
    "build",
    "expo-module.config.json",
    "android/build.gradle",
    "android/src/main",
    "android/domain/build.gradle.kts",
    "android/domain/src/main",
    "ios/Feja.podspec",
    "ios/FejaModule.swift",
    "ios/Beacon",
    "ios/CoreLocation",
    "ios/Expo",
    "ios/Functional",
    "ios/LocationAuthorization",
    "ios/Ranging",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
